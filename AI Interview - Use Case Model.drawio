        <mxCell id="complete-overview-comparison-conditions" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Comparison content and conditional changes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Always show both results: job/role, date, overall score, technical skills and communication scores.&lt;br&gt;&lt;br&gt;Same job description AND scoring criteria: show score changes and skill trends. Otherwise, hide score differences while keeping both results visible.&lt;br&gt;&lt;br&gt;Extension point: after both selected results are displayed side by side.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=20;fontSize=17;" vertex="1" parent="complete-overview-system">
