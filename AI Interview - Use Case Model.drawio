          <mxGeometry x="510" y="575" width="430" height="180" as="geometry" />
        </mxCell>
        <mxCell id="page-2-signed-in" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Already signed in&lt;/b&gt;&lt;br&gt;&lt;br&gt;The candidate can proceed to CV upload without signing in again.&lt;br&gt;&lt;br&gt;My Progress is also available directly to a signed-in candidate.&lt;br&gt;&lt;br&gt;Candidate is one role before and after authentication.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="page-2-1">
          <mxGeometry x="1250" y="235" width="380" height="290" as="geometry" />
        </mxCell>
        <mxCell id="page-2-auth-model" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Modeling decision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authentication is a precondition for protected use cases.&lt;br&gt;&lt;br&gt;The separate account goals do not require include or extend arrows between them.&lt;br&gt;&lt;br&gt;Automatic sign-in is part of successful account creation.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="page-2-1">
          <mxGeometry x="1250" y="575" width="380" height="285" as="geometry" />
