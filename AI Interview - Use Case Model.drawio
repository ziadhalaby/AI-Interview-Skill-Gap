        </mxCell>
        <mxCell id="page-1-relation-14" value="&amp;laquo;extend&amp;raquo;" style="html=1;fontFamily=Arial;fontSize=15;fontColor=#173C43;labelBackgroundColor=#FFFFFF;align=center;verticalAlign=middle;endArrow=open;endFill=0;startArrow=none;dashed=1;dashPattern=6 4;strokeColor=#365A68;strokeWidth=1.5;" edge="1" parent="page-1-system" source="page-1-show-changes" target="page-1-compare-interviews">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="page-1-access-rule" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Account access&lt;/b&gt;&lt;br&gt;&lt;br&gt;Account creation, sign-in and password recovery are available before authentication.&lt;br&gt;&lt;br&gt;All preparation, report and progress functions require a signed-in candidate.&lt;br&gt;&lt;br&gt;Successful account creation signs the candidate in automatically.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1250" y="155" width="380" height="285" as="geometry" />
        </mxCell>
        <mxCell id="page-1-match-rule" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Low match: training recommendation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generate a personalized training plan when match score is below the threshold.&lt;br&gt;&lt;br&gt;A low score still allows the candidate to start the mock interview immediately.&lt;br&gt;&lt;br&gt;Viewing or following the plan is optional.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1250" y="475" width="380" height="285" as="geometry" />
        </mxCell>
        <mxCell id="page-1-interview-rule" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Successful interview completion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Questions come from the Question Bank.&lt;br&gt;&lt;br&gt;Answers are submitted by voice, one question at a time.&lt;br&gt;&lt;br&gt;Evaluation and report generation follow the final submitted answer.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1250" y="795" width="380" height="285" as="geometry" />
        </mxCell>
        <mxCell id="page-1-comparison-rule" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Compare any two completed attempts&lt;/b&gt;&lt;br&gt;&lt;br&gt;Always display both selected results side by side.&lt;br&gt;&lt;br&gt;Show score changes and skill trends only when the job description AND scoring criteria match.&lt;br&gt;&lt;br&gt;Otherwise, hide score differences.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1250" y="1115" width="380" height="285" as="geometry" />
        </mxCell>
        <mxCell id="page-1-legend" value="Solid line: actor participation  |  Dashed open arrow: «include» points to required behavior; «extend» points to the base use case.  |  Connector direction does not describe time." style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=14;fontStyle=0;fontColor=#52666E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1470" width="1600" height="56" as="geometry" />
        </mxCell>
      </root>
