          <mxGeometry x="40" y="72" width="1600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="requirements-notes-card-1" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Account Access and Session Rules&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Create Account:&lt;/b&gt; Validate account details, create the account and sign the candidate in automatically. Existing email: show an existing-account message and offer sign-in. Invalid fields: show errors and allow correction and retry.&lt;br&gt;&lt;br&gt;&lt;b&gt;Sign In and recovery:&lt;/b&gt; Validate credentials before continuing to CV upload; incorrect credentials allow retry. Password recovery resets access and returns to sign-in.&lt;br&gt;&lt;br&gt;&lt;b&gt;Protected access:&lt;/b&gt; Preparation, reports and progress require a signed-in candidate. An existing session can go directly to CV upload or My Progress. Candidate is the same role before and after authentication.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="requirements-notes-1">
          <mxGeometry x="40" y="140" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="requirements-notes-card-2" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;CV and Job Description Inputs&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;CV extraction:&lt;/b&gt; Technical and soft skills, work experience, projects, education and certifications.&lt;br&gt;&lt;br&gt;&lt;b&gt;Job description analysis:&lt;/b&gt; Job title or role, required and preferred skills, experience level, educational qualifications and responsibilities.&lt;br&gt;&lt;br&gt;&lt;b&gt;Matching:&lt;/b&gt; Compare qualifications with weighted job requirements, calculate the overall matching percentage and make the matching result and skill gaps available for review.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scenario steps:&lt;/b&gt; Upload CV and paste the job description are steps within Assess CV–Job Match.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="requirements-notes-1">
          <mxGeometry x="860" y="140" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="requirements-notes-card-3" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Skill Gaps and Training Choices&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Gap interpretation:&lt;/b&gt; Distinguish missing skills from skills insufficiently evidenced in the CV.&lt;br&gt;&lt;br&gt;&lt;b&gt;Training extension:&lt;/b&gt; A score below the threshold triggers Generate Training Plan after matching results and gaps are available. The plan provides a personalized roadmap, learning resources and practical recommendations.&lt;br&gt;&lt;br&gt;&lt;b&gt;Candidate choice:&lt;/b&gt; The candidate may view the plan, start the mock interview immediately, or finish for now and return later. Viewing or following the plan is optional; a low score does not block the interview.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="requirements-notes-1">
          <mxGeometry x="40" y="560" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="requirements-notes-card-4" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Interview Setup Evaluation and Report&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Questions and answers:&lt;/b&gt; Select from the predefined Question Bank using role, required skills and experience level; questions are organized by domain and difficulty. Set up the interview, test the microphone, present one question at a time and collect voice answers.&lt;br&gt;&lt;br&gt;&lt;b&gt;After the final answer:&lt;/b&gt; Evaluate technical correctness, completeness, relevance and missing key concepts; evaluate clarity, organization, speaking rate, pauses and hesitation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Report and completion:&lt;/b&gt; Combine matching and interview results, strengths, weaknesses, gaps and recommendations in the report; save the completed attempt in Interview History.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="requirements-notes-1">
          <mxGeometry x="860" y="560" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="requirements-notes-card-5" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;History Reports and Comparison Rules&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;History and selection:&lt;/b&gt; My Progress lists completed attempts. Compare exactly two completed interviews; with fewer than two, offer Start a mock interview.&lt;br&gt;&lt;br&gt;&lt;b&gt;Comparison:&lt;/b&gt; Always display role/job, date, overall score, technical skills and communication scores for both attempts. Show score changes and skill trends only for the same job description AND scoring criteria; otherwise keep both results visible and hide score differences.&lt;br&gt;&lt;br&gt;&lt;b&gt;Report access:&lt;/b&gt; Review a report after assessment, from history or from either comparison result. Download the available report, view progress or practice again.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="requirements-notes-1">
          <mxGeometry x="40" y="980" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="requirements-notes-card-6" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;How to Read the UML Drawings&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Notation:&lt;/b&gt; Solid lines show candidate participation. A dashed include arrow points from the base use case to required behavior. A dashed extend arrow points from conditional behavior to its base. These arrows do not show screen order or time.&lt;br&gt;&lt;br&gt;&lt;b&gt;Extension points:&lt;/b&gt; Assess CV–Job Match: after the matching result and gaps are available. Compare Interviews: after both results are displayed side by side.&lt;br&gt;&lt;br&gt;&lt;b&gt;Scope:&lt;/b&gt; Functional view of the complete application, including AI assessment and the Question Bank. Authentication is a precondition for protected goals. The remaining Scenarios tabs describe each goal in detail.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="requirements-notes-1">
          <mxGeometry x="860" y="980" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="requirements-notes-source-footer" value="Consolidated from the notes previously shown on the UML pages. Detailed scenarios remain in their existing tabs." style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;fontColor=#52666E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="requirements-notes-1">
          <mxGeometry x="40" y="1435" width="1600" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-6" name="Scenarios — Access and Matching">
    <mxGraphModel dx="1680" dy="1530" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1530" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto">
      <root>
        <mxCell id="page-6-0" />
        <mxCell id="page-6-1" parent="page-6-0" />
        <mxCell id="page-6-title" value="Scenarios — Access and Matching" style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#173C43;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="page-6-1">
          <mxGeometry x="40" y="24" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="page-6-subtitle" value="Use case descriptions | Same names as the diagrams | Candidate is the initiating actor for the primary goals." style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;fontColor=#52666E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="page-6-1">
          <mxGeometry x="40" y="72" width="1600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="page-6-spec-1" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Create Account&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate has not signed in.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate chooses Create Account and enters account details. The system validates the details, creates the account and signs the candidate in automatically. CV upload becomes available.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alternatives:&lt;/b&gt; An existing email produces an existing-account message and a route to sign-in. Invalid fields are shown for correction and retry.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; A candidate account and signed-in session exist.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-6-1">
          <mxGeometry x="40" y="140" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-6-spec-2" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Sign In&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate has an existing account and is not signed in.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate enters credentials. The system validates them, establishes a session and allows preparation to continue at CV upload.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alternatives:&lt;/b&gt; Incorrect email or password displays an error and allows retry. Candidate may initiate Reset Password.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; A signed-in session exists. An already signed-in candidate can access CV upload or My Progress directly.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-6-1">
          <mxGeometry x="860" y="140" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-6-spec-3" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Reset Password&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate needs to recover access to an existing account.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate selects the password recovery option from sign-in, completes the recovery process, then returns to sign-in with the updated password.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; The candidate can attempt sign-in after the password has been reset.&lt;br&gt;&lt;br&gt;&lt;b&gt;Source limit:&lt;/b&gt; Recovery transport, token rules and expiry are not specified; no particular mechanism is assumed.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-6-1">
          <mxGeometry x="40" y="560" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-6-spec-4" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Assess CV–Job Match&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate is signed in.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate uploads a CV, pastes a job description and requests analysis. The system extracts CV information, analyzes job requirements, calculates the weighted matching percentage and identifies skill gaps. Candidate reviews the result.&lt;br&gt;&lt;br&gt;&lt;b&gt;Low-match extension:&lt;/b&gt; Generate Training Plan applies when the percentage is below the configured threshold.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Matching percentage and skill gaps are available. The candidate may start an interview even with a low score.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-6-1">
          <mxGeometry x="860" y="560" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-6-spec-5" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;View Training Plan&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate is signed in and a generated training plan is available.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate chooses to view the recommendation and reviews the personalized roadmap, relevant learning resources and practical recommendations.&lt;br&gt;&lt;br&gt;&lt;b&gt;Choices:&lt;/b&gt; Start the mock interview after reviewing the plan, or finish for now and return later. The candidate may also start immediately without opening the plan.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Candidate has reviewed the suggested improvements; starting an interview remains optional.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-6-1">
          <mxGeometry x="40" y="980" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-6-spec-6" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Generate Training Plan&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Type and trigger:&lt;/b&gt; System behavior extending Assess CV–Job Match when match score is below the threshold.&lt;br&gt;&lt;br&gt;&lt;b&gt;Behavior:&lt;/b&gt; Use the identified gaps to produce a personalized improvement roadmap with relevant learning resources and practical recommendations. Distinguish missing skills from skills insufficiently evidenced in the CV.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; A training plan is available for the candidate to view.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule:&lt;/b&gt; Training is recommended; interview access is available immediately.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-6-1">
          <mxGeometry x="860" y="980" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-6-spec-footer" value="Source: current root proposal, Methodology — Onboarding through Skill Gap Analysis; current User flow — Getting started, Account access and Interview preparation." style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;fontColor=#52666E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="page-6-1">
          <mxGeometry x="40" y="1435" width="1600" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-7" name="Scenarios — Interview and Reports">
    <mxGraphModel dx="1680" dy="1530" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1530" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto">
      <root>
        <mxCell id="page-7-0" />
        <mxCell id="page-7-1" parent="page-7-0" />
        <mxCell id="page-7-title" value="Scenarios — Interview and Reports" style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#173C43;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="page-7-1">
          <mxGeometry x="40" y="24" width="1600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="page-7-subtitle" value="Use case descriptions | Internal assessment behavior is required on successful completion of the interview." style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;fontColor=#52666E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="page-7-1">
          <mxGeometry x="40" y="72" width="1600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="page-7-spec-1" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Take Mock Interview&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate is signed in; a target job and its CV–job matching context are available. No minimum matching score is required.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate starts now or returns after reviewing the plan. The interview is set up and the microphone is tested. The system selects questions, presents them individually and collects voice answers. After the final answer, it evaluates the interview and generates the report.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; A completed attempt and its report are available, and the attempt appears in Interview History.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-7-1">
          <mxGeometry x="40" y="140" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-7-spec-2" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Select Interview Questions&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Type:&lt;/b&gt; Required behavior included by Take Mock Interview.&lt;br&gt;&lt;br&gt;&lt;b&gt;Inputs:&lt;/b&gt; Target role, required skills and experience level.&lt;br&gt;&lt;br&gt;&lt;b&gt;Behavior:&lt;/b&gt; Choose relevant questions from the predefined Question Bank, organized by technical domain and difficulty level.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Questions appropriate to the interview context are selected. The source documents do not specify a question count or selection algorithm.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-7-1">
          <mxGeometry x="860" y="140" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-7-spec-3" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Record and Submit Voice Answers&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Type:&lt;/b&gt; Required behavior included by Take Mock Interview.&lt;br&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Interview setup and microphone test are complete; selected questions are available.&lt;br&gt;&lt;br&gt;&lt;b&gt;Behavior:&lt;/b&gt; Present one question at a time. Candidate records and submits a voice answer for each presented question. Collect the responses for analysis.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Submitted responses are available for assessment after the final answer. Re-record, skip and interruption policies are not defined in the sources.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-7-1">
          <mxGeometry x="40" y="560" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-7-spec-4" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Evaluate Interview and Generate Report&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; The interview has reached its final submitted answer.&lt;br&gt;&lt;br&gt;&lt;b&gt;Technical assessment:&lt;/b&gt; Evaluate correctness, completeness, relevance and missing key concepts.&lt;br&gt;&lt;br&gt;&lt;b&gt;Communication assessment:&lt;/b&gt; Evaluate clarity, organization, speaking rate, pauses and hesitation indicators.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Generate a report combining CV–job matching and interview results, strengths, weaknesses, technical gaps, communication improvement areas and personalized recommendations.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-7-1">
          <mxGeometry x="860" y="560" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-7-spec-5" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;View Assessment Report&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate is signed in and the selected assessment report exists.&lt;br&gt;&lt;br&gt;&lt;b&gt;Entry points:&lt;/b&gt; After completing assessment, from an individual Interview History attempt, or from either attempt in a comparison.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate opens the report. The system displays matching and interview assessment results with strengths, weaknesses, gaps and improvement recommendations.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Candidate reviews the report and may download it, view progress or practice again.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-7-1">
          <mxGeometry x="40" y="980" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-7-spec-6" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Download Assessment Report&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate is signed in and the selected report is available.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate requests a download. The system provides the selected assessment report for saving and future reference.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Candidate obtains a downloadable copy of the report.&lt;br&gt;&lt;br&gt;&lt;b&gt;Modeling note:&lt;/b&gt; Downloading is a separate candidate goal. Viewing and downloading an existing report do not require rerunning the assessment. The download file format is not specified.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" vertex="1" parent="page-7-1">
          <mxGeometry x="860" y="980" width="780" height="390" as="geometry" />
        </mxCell>
        <mxCell id="page-7-spec-footer" value="Source: current root proposal, Methodology — Question Selection through Final Assessment Report; current User flow — Interview setup, voice answers, report review and download." style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;fontColor=#52666E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="page-7-1">
          <mxGeometry x="40" y="1435" width="1600" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-8" name="Scenarios — History Comparison and Scope">
    <mxGraphModel dx="2049" dy="1219" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1530" background="#FFFFFF" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="page-8-0" />
        <mxCell id="page-8-1" parent="page-8-0" />
        <mxCell id="page-8-title" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#173C43;align=left;verticalAlign=middle;spacing=0;" value="Scenarios — History Comparison and Scope" vertex="1">
          <mxGeometry height="40" width="1600" x="40" y="24" as="geometry" />
        </mxCell>
        <mxCell id="page-8-subtitle" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=16;fontStyle=0;fontColor=#52666E;align=left;verticalAlign=middle;spacing=0;" value="Use case descriptions and shared modeling rules | Comparison validity is separate from the ability to display two results." vertex="1">
          <mxGeometry height="36" width="1600" x="40" y="72" as="geometry" />
        </mxCell>
        <mxCell id="page-8-spec-1" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;View Interview History&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate is signed in.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate opens My Progress. The system displays Interview History containing completed mock interviews. Candidate may open an attempt to view its full report.&lt;br&gt;&lt;br&gt;&lt;b&gt;Comparison entry:&lt;/b&gt; With at least two completed interviews, the candidate can choose comparison and select two. With fewer than two, the flow offers Start a mock interview.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Candidate can review previous attempts or choose the next preparation action.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="780" x="40" y="140" as="geometry" />
        </mxCell>
        <mxCell id="page-8-spec-2" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Compare Interviews&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Precondition:&lt;/b&gt; Candidate is signed in and has at least two completed attempts.&lt;br&gt;&lt;br&gt;&lt;b&gt;Main scenario:&lt;/b&gt; Candidate selects exactly two completed interviews, then chooses View Comparison. The system displays both results side by side and checks whether their job description and scoring criteria match.&lt;br&gt;&lt;br&gt;&lt;b&gt;Conditional extension:&lt;/b&gt; When both match, show score changes and skill trends. Otherwise, keep side-by-side results and hide score differences.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Candidate reviews the comparison and may open either full report.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="780" x="860" y="140" as="geometry" />
        </mxCell>
        <mxCell id="page-8-spec-3" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Display Interview Results Side by Side&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Type:&lt;/b&gt; Required behavior included by Compare Interviews.&lt;br&gt;&lt;br&gt;&lt;b&gt;Behavior:&lt;/b&gt; Display the earlier and later selected attempts with job/role, date, overall score, technical skills and communication scores.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule:&lt;/b&gt; Different job descriptions or scoring criteria do not block the side-by-side display.&lt;br&gt;&lt;br&gt;&lt;b&gt;Result:&lt;/b&gt; Both results remain visible and each full assessment report can be opened.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="780" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="page-8-spec-4" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Show Score Changes and Skill Trends&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Type:&lt;/b&gt; System behavior extending Compare Interviews after both results are displayed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Condition:&lt;/b&gt; The selected attempts use the same job description AND the same scoring criteria.&lt;br&gt;&lt;br&gt;&lt;b&gt;Behavior:&lt;/b&gt; Show score changes and skill trends so the candidate can see improvements and areas to practice next.&lt;br&gt;&lt;br&gt;&lt;b&gt;Otherwise:&lt;/b&gt; Do not apply this extension. Keep the two results visible while score differences remain hidden.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="780" x="860" y="560" as="geometry" />
        </mxCell>
        <mxCell id="page-8-spec-5" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Shared Scope and UML Rules&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;Actor:&lt;/b&gt; Candidate represents students, graduates and job seekers. Authentication is a state of this role.&lt;br&gt;&lt;br&gt;&lt;b&gt;System boundary:&lt;/b&gt; Functional view of the complete application, including its AI assessment responsibilities and Question Bank. No administrator or recruiter functions are specified.&lt;br&gt;&lt;br&gt;&lt;b&gt;Relations:&lt;/b&gt; Include points from base to required behavior. Extend points from conditional behavior to its base. The lines do not specify execution order.&lt;br&gt;&lt;br&gt;&lt;b&gt;Consistency:&lt;/b&gt; Use the same named goals across all diagram pages and scenario descriptions; no visible use case codes.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="780" x="40" y="980" as="geometry" />
        </mxCell>
        <mxCell id="page-8-spec-6" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;rounded=0;whiteSpace=wrap;fillColor=#F7FAFB;strokeColor=#B5C9CE;strokeWidth=1;align=left;verticalAlign=top;spacing=22;fontSize=16;" value="&lt;div style=&quot;line-height:1.4;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:21px;color:#147D80;&quot;&gt;&lt;b&gt;Details Not Defined by the Sources&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;b&gt;File handling:&lt;/b&gt; Accepted CV formats and sizes, invalid-file handling, audio retention and storage policy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Interview behavior:&lt;/b&gt; Question count, duration, skip, re-record, interruption and resume behavior.&lt;br&gt;&lt;br&gt;&lt;b&gt;Configuration:&lt;/b&gt; Numeric threshold, scoring formula and versioning, recovery transport and report download format.&lt;br&gt;&lt;br&gt;&lt;b&gt;Treatment:&lt;/b&gt; These are implementation decisions to agree later. They are not invented restrictions or additional use cases in this model.&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="390" width="780" x="860" y="980" as="geometry" />
        </mxCell>
        <mxCell id="page-8-spec-footer" parent="page-8-1" style="html=1;fontFamily=Arial;fontColor=#173C43;text;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;fontSize=15;fontStyle=0;fontColor=#52666E;align=left;verticalAlign=middle;spacing=0;" value="Source: current root proposal, Methodology — Interview History and Comparison; current User flow — Progress and comparison. Earlier output/pdf proposal is superseded for this model." vertex="1">
          <mxGeometry height="65" width="1600" x="40" y="1435" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
