        </mxCell>
        <mxCell id="complete-overview-account-outcomes" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Account actions and alternatives&lt;/b&gt;&lt;br&gt;&lt;br&gt;Create Account: validate details, create the account and sign the candidate in automatically.&lt;br&gt;&lt;br&gt;Existing email: show an existing-account message and offer sign-in.&lt;br&gt;&lt;br&gt;Invalid fields: show the errors and allow correction and retry.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=20;fontSize=17;" vertex="1" parent="complete-overview-system">
