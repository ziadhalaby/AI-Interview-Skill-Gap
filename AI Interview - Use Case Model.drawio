        <mxCell id="page-2-create-details" value="&lt;div style=&quot;line-height:1.35;text-align:left;&quot;&gt;&lt;b&gt;Create Account&lt;/b&gt;&lt;br&gt;&lt;br&gt;Validate account details, create the account and sign in automatically.&lt;br&gt;&lt;br&gt;Email already registered: show an existing-account message and offer sign-in.&lt;br&gt;&lt;br&gt;Invalid fields: show field errors; allow correction and retry.&lt;/div&gt;" style="html=1;fontFamily=Arial;fontColor=#173C43;shape=note;size=18;whiteSpace=wrap;fillColor=#FFF9E8;strokeColor=#C7B57B;strokeWidth=1;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="page-2-system">
          <mxGeometry x="510" y="95" width="430" height="245" as="geometry" />
        </mxCell>
